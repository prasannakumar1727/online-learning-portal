# Default backend address baked into the build (can be changed at runtime in the app: Server settings).
# Browser on the same PC:        http://localhost:5000
# Android emulator -> your PC:   http://10.0.2.2:5000
# Physical phone, same Wi-Fi:    http://<your-PC-LAN-IP>:5000
# Deployed server (recommended): https://your-api.example.com
VITE_API_URL=http://localhost:5000
